# === Telegram ===
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# === Google Gemini (AI Studio) ===
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.5-flash-lite

# === Google Drive ===
# Вариант 1 (OAuth 2.0 - рекомендуется):
GOOGLE_CLIENT_SECRET_FILE=credentials/client_secret.json
GOOGLE_TOKEN_FILE=credentials/token.json

# Вариант 2 (Service Account):
# GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json

# ID папки Google Drive, куда сохранять рилсы
GOOGLE_DRIVE_FOLDER_ID=1aBcDeFgHiJkLmNoPqRsTuVwXyZ

# === Instagram DM Integration (Webhooks) ===
# Токен страницы Facebook / Instagram Graph API
# INSTAGRAM_PAGE_ACCESS_TOKEN=EAAG...
# Секретный токен верификации вебхука (любая случайная строка, которую вы введёте в Meta Developer Portal)
INSTAGRAM_VERIFY_TOKEN=reels_bot_secret_token
# Секретный ключ приложения Meta (для проверки подписи HMAC SHA256)
# INSTAGRAM_APP_SECRET=abc123xyz...
INSTAGRAM_WEBHOOK_HOST=0.0.0.0
INSTAGRAM_WEBHOOK_PORT=8080
INSTAGRAM_ENABLE_WEBHOOK=true

# === Опционально ===
# ID вашего приватного Telegram-канала для дублирования карточек (опционально)
# TELEGRAM_CHANNEL_ID=-100123456789
